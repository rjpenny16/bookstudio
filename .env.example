# AI provider for the publishing agent. One of: anthropic | ollama | codex | offline
# "codex" writes with your ChatGPT subscription through the codex CLI (same setup as IMAGE_PROVIDER=codex below).
# "offline" uses deterministic built-in heuristics so the app works with no model at all.
AI_PROVIDER=anthropic

# Anthropic (Claude). The SDK also accepts ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional model for AI_PROVIDER=codex; leave empty for codex's default.
CODEX_TEXT_MODEL=
# How many codex writing calls may run at once (default 2). Higher is faster but uses your ChatGPT limits sooner.
CODEX_CONCURRENCY=
# Minutes one codex writing call may take before it's stopped (default 25 for murder mystery tasks, 8 for the rest).
CODEX_TEXT_TIMEOUT_MINUTES=

# Self-hosted models through Ollama's native chat API (e.g. a Qwen-family model)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Cover art with a ChatGPT subscription instead of an API key (optional): install the codex CLI
# (npm install -g @openai/codex), run `codex login`, and set IMAGE_PROVIDER=codex. Uses the
# gpt-image-bridge script in .claude/skills/gpt-image-bridge (override with CODEX_IMAGE_BRIDGE).
# Slow (about 2 to 6 minutes per image) but not billed per image. Takes precedence over OPENAI_API_KEY.
IMAGE_PROVIDER=
CODEX_IMAGE_BRIDGE=
# Windows: the bridge runs in Git for Windows' bash, found automatically; set this if it's elsewhere.
CODEX_BASH=

# Cover art through the OpenAI Images API (optional). Without a key, covers use the vector templates.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# low | medium | high
OPENAI_IMAGE_QUALITY=high

# Market data (optional): price books against their competitors and fill keyword slots by search volume.
# Licensed APIs only; BookStudio never scrapes Amazon. See src/lib/market/LEGAL.md.
# Keepa (https://keepa.com/#!api): competing books, prices, reviews and sales rank history. Billed in tokens.
KEEPA_API_KEY=
# DataForSEO (https://dataforseo.com): monthly Amazon search volumes. Pay as you go.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Phone inbox (optional): post book ideas in a private Discord channel and an open BookStudio tab builds
# each draft. See "Phone inbox" in the README for the 10-minute setup. Restart the server after changing.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Your Discord user id; messages from anyone else are ignored.
DISCORD_OWNER_ID=
# Optional: the address the "Review & Publish" links in Discord replies point to (default http://localhost:3000).
BOOKSTUDIO_URL=
